{
  "programs": ["sh", "bash", "zsh", "fish", "dash", "ksh", "tcsh", "csh", "login", "su", "nu", "pwsh", "xonsh", "elvish", "ssh", "sshd", "mosh-server", "tmux", "screen", "zellij", "claude"],
