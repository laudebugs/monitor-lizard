    { "exe": "/Applications/Cursor.app/Contents/Frameworks/Cursor Helper.app/Contents/MacOS/Cursor Helper", "command": "Cursor Helper", "danger": true },
    { "exe": "/Users/me/.local/bin/claude", "command": "claude --resume", "danger": true },
