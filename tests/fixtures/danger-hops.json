    { "exe": "/opt/homebrew/bin/node", "command": "node /x/node_modules/@anthropic-ai/claude-code/cli.js", "danger": true },
    { "exe": "/opt/homebrew/bin/node", "command": "node build.js", "danger": false },
    { "exe": "/usr/bin/git", "command": "git status", "danger": false },
    { "exe": "/Applications/Terminalizer.app/Contents/MacOS/x", "command": "x", "danger": false },
