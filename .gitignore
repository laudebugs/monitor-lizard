# OS and editors
.DS_Store
._*
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Secrets: commit only the .example files
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key

# Logs and local state
*.log
.pnpm-store/
node_modules/
target/
dist/
coverage/

# Worktrees created inside the repo, and per-machine agent settings
.worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# This repo
/target
# Regenerated by tauri-build on every build; pure schema output for editor tooling, not source
src-tauri/gen/
# Not a build output: the shell's window loads the loopback server, not a bundled frontend, so this
# is a static, tracked placeholder `frontendDist` -- excluded by the generic `dist/` rule above otherwise
!src-tauri/dist/
!src-tauri/dist/index.html
